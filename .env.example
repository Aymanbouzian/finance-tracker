# Docker Compose reads this file after copying it to .env. Never commit .env.
# For local runserver, set process environment variables instead (see README).
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Example for a hosted install: https://money.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 only when served over HTTPS (enables secure cookies)
DJANGO_HTTPS=0

APP_CURRENCY=MAD
APP_TIME_ZONE=Africa/Casablanca

# Optional AI. Install/pull the model separately; disabled by default.
OLLAMA_ENABLED=0
# Compose reaches Ollama on the Docker host. Local runserver uses 127.0.0.1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=45

POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me-use-a-unique-database-password
